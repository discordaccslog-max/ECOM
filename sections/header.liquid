<style>
    /* License Button Container */
    .license-button-container {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 10px;
        z-index: 100;
    }
    
    /* License Button Styling to match your theme */
    .license-view-button {
        background: #d4a574;
        color: #000;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.3s;
        text-transform: none;
        white-space: nowrap;
    }
    
    .license-view-button:hover {
        background: #c99a66;
        transform: translateY(-1px);
    }
    
    /* Modal Overlay - Dark theme */
    .license-modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }
    
    .license-modal-overlay.active {
        display: flex;
    }
    
    /* Modal Content - Dark theme matching your site */
    .license-modal-content {
        background: #1a1a1a;
        border-radius: 8px;
        padding: 40px;
        max-width: 550px;
        width: 100%;
        position: relative;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
        max-height: 90vh;
        overflow-y: auto;
        border: 1px solid #333;
    }
    
    .license-modal-content::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #d4a574 0%, #c99a66 50%, #d4a574 100%);
        border-radius: 8px 8px 0 0;
    }
    
    /* Close Button */
    .license-close-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #2a2a2a;
        border: 1px solid #444;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        font-size: 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d4a574;
        transition: all 0.3s;
    }
    
    .license-close-btn:hover {
        background: #333;
        color: #fff;
    }
    
    .license-header {
        text-align: center;
        margin-bottom: 30px;
        margin-top: 10px;
    }
    
    .license-badge {
        display: inline-block;
        background: #d4a574;
        color: #000;
        padding: 8px 20px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        letter-spacing: 1px;
        margin-bottom: 15px;
    }
    
    .license-vendor-name {
        font-size: 48px;
        font-weight: bold;
        color: #fff;
        margin: 20px 0;
        letter-spacing: 2px;
    }
    
    .license-info-box {
        background: #0f0f0f;
        border-radius: 8px;
        padding: 25px;
        margin: 25px 0;
        border: 1px solid #2a2a2a;
    }
    
    .license-info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #2a2a2a;
    }
    
    .license-info-row:last-child {
        border-bottom: none;
    }
    
    .license-info-label {
        color: #888;
        font-weight: 600;
        font-size: 14px;
    }
    
    .license-info-value {
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        text-align: right;
    }
    
    .license-verified-seal {
        text-align: center;
        margin-top: 30px;
    }
    
    .license-seal-icon {
        width: 80px;
        height: 80px;
        background: #d4a574;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #000;
        font-size: 36px;
        margin-bottom: 10px;
        box-shadow: 0 4px 12px rgba(212, 165, 116, 0.4);
    }
    
    .license-verified-text {
        color: #d4a574;
        font-weight: bold;
        font-size: 16px;
        margin-top: 10px;
    }
    
    .license-footer-text {
        text-align: center;
        color: #666;
        font-size: 11px;
        margin-top: 25px;
        line-height: 1.6;
    }
    
    .license-official-box {
        background: #0f0f0f;
        border: 1px solid #d4a574;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
        text-align: center;
    }
    
    .license-official-title {
        color: #d4a574;
        font-weight: bold;
        font-size: 13px;
        margin-bottom: 10px;
        letter-spacing: 1px;
    }
    
    .license-official-text {
        color: #888;
        font-size: 12px;
        line-height: 1.6;
    }
    
    /* Make header icons container relative for positioning */
    .header__icons {
        position: relative;
    }
    
    @media (max-width: 990px) {
        .license-button-container {
            position: static;
            margin-top: 15px;
            text-align: center;
        }
    }
    
    @media (max-width: 600px) {
        .license-modal-content {
            padding: 30px 20px;
        }
        
        .license-vendor-name {
            font-size: 36px;
        }
    }
</style>

